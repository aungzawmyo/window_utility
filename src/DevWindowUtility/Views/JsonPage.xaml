<UserControl x:Class="DevWindowUtility.Views.JsonPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="JSON"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageSubtitle}"
                   Text="Format, minify, validate, and inspect JSON."/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Format" Command="{Binding FormatCommand}"/>
            <Button Content="Minify" Command="{Binding MinifyCommand}" Margin="8,0,0,0"/>
            <Button Content="Validate" Command="{Binding ValidateCommand}" Margin="8,0,0,0"/>
            <Button Content="Open" Command="{Binding OpenCommand}" Margin="8,0,0,0"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Margin="8,0,0,0"/>
            <Button Content="Save as" Command="{Binding SaveAsCommand}" Margin="8,0,0,0"/>
            <Button Content="Copy" Command="{Binding CopyCommand}" Margin="8,0,0,0"/>
            <Button Content="Clear" Command="{Binding ClearCommand}" Margin="8,0,0,0"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource StatusText}"
                   Text="{Binding Status}" TextWrapping="Wrap"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Style="{StaticResource EditorTextBox}"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     Tag="Paste JSON here"/>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"/>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource GroupTitle}" Text="Tree"/>
                <TreeView ItemsSource="{Binding Tree}">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Kind}" Margin="8,0,0,0" Opacity="0.55"/>
                                <TextBlock Text="{Binding Preview}" Margin="8,0,0,0" Opacity="0.75"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
