<UserControl x:Class="DevWindowUtility.Views.HostsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Hosts"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageSubtitle}" Text="{Binding HostsPath}"/>

        <Border DockPanel.Dock="Top" Style="{StaticResource Banner}" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Restart as administrator"
                        Command="{Binding RestartAsAdministratorCommand}"
                        Visibility="{Binding IsAdministrator, Converter={StaticResource InverseBoolToVisibility}}"/>
                <TextBlock Text="{Binding AdminStatus}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox Width="140" Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Tag="IP address"/>
            <TextBox Width="220" Text="{Binding NewHost, UpdateSourceTrigger=PropertyChanged}"
                     Margin="8,0,0,0" VerticalContentAlignment="Center" Tag="hostname"/>
            <Button Content="Add" Command="{Binding AddCommand}" Margin="8,0,0,0"/>
            <Button Content="Toggle" Command="{Binding ToggleCommand}" Margin="8,0,0,0"/>
            <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="8,0,0,0"
                    Style="{StaticResource DangerButton}"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Margin="8,0,0,0"/>
            <Button Content="Reload" Command="{Binding ReloadCommand}" Margin="8,0,0,0"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource StatusText}" Text="{Binding Status}" TextWrapping="Wrap"/>

        <DataGrid ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedEntry}"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                <DataGridTextColumn Header="Address" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                <DataGridTextColumn Header="Hosts" Binding="{Binding Hosts, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                <DataGridTextColumn Header="Comment" Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
