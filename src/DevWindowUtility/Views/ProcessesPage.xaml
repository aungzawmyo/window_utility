<UserControl x:Class="DevWindowUtility.Views.ProcessesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Processes"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageSubtitle}"
                   Text="Search running processes and kill by PID or name."/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox Width="260" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     Tag="Search name, PID, or window title"/>
            <Button Content="Kill selected" Command="{Binding KillSelectedCommand}" Margin="8,0,0,0"
                    Style="{StaticResource DangerButton}"/>
            <Button Content="Kill by name" Command="{Binding KillByNameCommand}" Margin="8,0,0,0"
                    Style="{StaticResource DangerButton}"/>
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource StatusText}" Text="{Binding Status}" TextWrapping="Wrap"/>

        <DataGrid ItemsSource="{Binding Processes}"
                  SelectedItem="{Binding SelectedProcess}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                <DataGridTextColumn Header="Memory (MB)" Binding="{Binding MemoryMb}" Width="110"/>
                <DataGridTextColumn Header="Window title" Binding="{Binding WindowTitle}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
