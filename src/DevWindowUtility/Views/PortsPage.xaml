<UserControl x:Class="DevWindowUtility.Views.PortsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Ports"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageSubtitle}"
                   Text="Check a TCP port, list listeners, and kill the owning process."/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox Width="140" Text="{Binding PortInput, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Port (1-65535)"/>
            <Button Content="Check port" Command="{Binding CheckPortCommand}" Margin="8,0,0,0"/>
            <Button Content="Kill by port" Command="{Binding KillByPortCommand}" Margin="8,0,0,0"
                    Style="{StaticResource DangerButton}"/>
            <Button Content="Kill selected" Command="{Binding KillSelectedCommand}" Margin="8,0,0,0"
                    Style="{StaticResource DangerButton}"/>
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
        </StackPanel>

        <TextBox DockPanel.Dock="Top" Margin="0,0,0,8"
                 Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                 Tag="Filter by port, PID, process, or address"/>

        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource StatusText}" Text="{Binding Status}" TextWrapping="Wrap"/>

        <DataGrid ItemsSource="{Binding Ports}"
                  SelectedItem="{Binding SelectedPort}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80"/>
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="180"/>
                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
