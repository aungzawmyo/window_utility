<UserControl x:Class="DevWindowUtility.Views.ExplorerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Explorer"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageSubtitle}"
                   Text="Browse folders. Double-click a folder to open it, or pin it to favorites."/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Up" Command="{Binding UpCommand}"/>
            <Button Content="Go" Command="{Binding GoCommand}" Margin="8,0,0,0"/>
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
            <TextBox Width="420" Margin="8,0,0,0"
                     Text="{Binding CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Folder path"/>
            <TextBox Width="160" Margin="8,0,0,0"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Filter name"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Open" Command="{Binding OpenSelectedCommand}"/>
            <Button Content="Open in Explorer" Command="{Binding OpenInExplorerCommand}" Margin="8,0,0,0"/>
            <Button Content="Open in Notepad" Command="{Binding OpenInNotepadCommand}" Margin="8,0,0,0"/>
            <Button Content="Open in JSON" Command="{Binding OpenInJsonCommand}" Margin="8,0,0,0"/>
            <Button Content="Copy path" Command="{Binding CopyPathCommand}" Margin="8,0,0,0"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource StatusText}"
                   Text="{Binding Status}" TextWrapping="Wrap"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource GroupTitle}" Text="Favorites"/>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="Pin current" Command="{Binding PinCurrentCommand}" Margin="0,0,0,6"/>
                    <Button Content="Add folder" Command="{Binding AddFavoriteCommand}" Margin="0,0,0,6"/>
                    <Button Content="Remove" Command="{Binding RemoveFavoriteCommand}"
                            Style="{StaticResource DangerButton}"/>
                </StackPanel>
                <ListBox Style="{StaticResource CompactListBox}"
                         ItemContainerStyle="{StaticResource CompactListBoxItem}"
                         ItemsSource="{Binding Favorites}"
                         SelectedItem="{Binding SelectedFavorite}"
                         DisplayMemberPath="Name"
                         MouseDoubleClick="Favorites_OnMouseDoubleClick"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"/>

            <DataGrid Grid.Column="2"
                      ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      MouseDoubleClick="Entries_OnMouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90"/>
                    <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
