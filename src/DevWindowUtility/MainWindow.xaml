<Window x:Class="DevWindowUtility.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dev Helper"
        Icon="pack://application:,,,/Assets/app.png"
        Height="720" Width="1100"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,20,16,16">
                <Image Source="pack://application:,,,/Assets/app.png"
                       Width="36" Height="36" Margin="0,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Dev Helper" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Developer tools" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>
            <ListBox Style="{StaticResource NavListBox}"
                     ItemContainerStyle="{StaticResource NavListBoxItem}"
                     ItemsSource="{Binding NavItems}"
                     SelectedItem="{Binding SelectedNav}"
                     DisplayMemberPath="Title"/>
        </DockPanel>

        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentPage}"
                        Margin="24,20,24,16"/>
    </Grid>
</Window>
